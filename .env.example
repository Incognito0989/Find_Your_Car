# ==============================================================================
# Plate Snap / Cars Backend Server Configuration
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# Server Port & Mode
PORT=3000
NODE_ENV=production
BACKEND_ONLY=false

# PostgreSQL Database Configuration (Containerized)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=platesnap
POSTGRES_PASSWORD=platesnap_secret_pass
POSTGRES_DB=platesnap_db
# Or explicit full connection string:
# DATABASE_URL=postgres://platesnap:platesnap_secret_pass@postgres:5432/platesnap_db

# Admin Authentication
ADMIN_EMAIL=admin@platesnapcars.local
ADMIN_PASSWORD=platesnap2026
ADMIN_NAME="Lead Automotive Photographer"

# AI Cartoon & Sticker Generation Engine
# Options: 'comfyui' (Docker/local container) | 'gemini' (Google AI) | 'local_canvas' (Algorithmic)
CARTOON_ENGINE=comfyui
COMFYUI_API_URL=http://comfyui:8188
COMFYUI_PORT=8188

# Cloud AI Engine (Fallback or Online Model)
GEMINI_API_KEY=

# Cloudflare Tunnel Configuration (Optional):
# 1. For a free quick tunnel (default), leave this empty.
# 2. For a permanent custom domain tunnel from Cloudflare Zero Trust:
# CLOUDFLARE_TUNNEL_COMMAND="tunnel --no-autoupdate run"
# CLOUDFLARE_TUNNEL_TOKEN="your_cloudflare_zero_trust_tunnel_token_here"

# Vercel Frontend Environment Variable:
# Set this in your Vercel Project Settings to your public backend URL or Cloudflare / ngrok tunnel:
# VITE_API_URL=https://api.yourdomain.com
